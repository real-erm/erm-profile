        // Update HTML attributes
        document.documentElement.setAttribute('dir', isAr ? 'rtl' : 'ltr');
        document.documentElement.setAttribute('lang', lang);

        // Update all data-i18n elements
        document.querySelectorAll('[data-i18n]').forEach((el) => {
          const key = el.getAttribute('data-i18n');
          const val = getNestedTranslation(dict, key);
          if (val) {
            el.textContent = val;
          }
        });

        // Update language button text
        langLabel.textContent = dict.langBtn;

        // Reset typewriter with new language words
        resetTypewriter();

        // Save preference
        try {
          localStorage.setItem('erm_lang', lang);
        } catch (e) {}
      }

      langToggleBtn.addEventListener('click', () => {
        playCyberClick(1100, 0.04);
        const nextLang = currentLang === 'en' ? 'ar' : 'en';
        applyTranslations(nextLang);
      });

      // Restore saved language if any
      try {
        const savedLang = localStorage.getItem('erm_lang');
        if (savedLang && (savedLang === 'en' || savedLang === 'ar')) {
          if (savedLang !== currentLang) {
            applyTranslations(savedLang);
          }
        }
      } catch (e) {}

      // ========================================================
      // 7. COPY BUTTONS HANDLER
      // ========================================================
      document.querySelectorAll('.copy-btn').forEach((btn) => {
        btn.addEventListener('click', async (e) => {
          e.stopPropagation();
          const textToCopy = btn.getAttribute('data-copy');
          if (!textToCopy) return;

          try {
            await navigator.clipboard.writeText(textToCopy);
            showToast(translations[currentLang].common.copiedToast);
          } catch (err) {
            // Fallback for older browsers
            const textArea = document.createElement('textarea');
            textArea.value = textToCopy;
            document.body.appendChild(textArea);
            textArea.select();
            document.execCommand('copy');
            document.body.removeChild(textArea);
            showToast(translations[currentLang].common.copiedToast);
          }
        });
      });

      // ========================================================
      // 8. SFX TOGGLE
      // ========================================================
      const sfxToggleBtn = document.getElementById('sfx-toggle');
      const sfxIcon = document.getElementById('sfx-icon');
      if (sfxToggleBtn) {
        sfxToggleBtn.addEventListener('click', () => {
          sfxEnabled = !sfxEnabled;
          sfxIcon.textContent = sfxEnabled ? '🔊' : '🔇';
          if (sfxEnabled) {
            playCyberClick(880, 0.04);
            showToast("SFX: ENABLED");
          } else {
            showToast("SFX: MUTED");
          }
        });
      }

      // ========================================================
      // 9. LIVE REAL-TIME CLOCK (UTC)
      // ========================================================
      const liveClockEl = document.getElementById('live-clock');
      function updateClock() {
        if (!liveClockEl) return;
        const now = new Date();
        const hrs = String(now.getUTCHours()).padStart(2, '0');
        const mins = String(now.getUTCMinutes()).padStart(2, '0');
        const secs = String(now.getUTCSeconds()).padStart(2, '0');
        liveClockEl.textContent = `${hrs}:${mins}:${secs} UTC`;
      }
      setInterval(updateClock, 1000);
      updateClock();
    </script>
  </body>
</html>
