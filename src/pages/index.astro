---
import { Icon } from 'astro-icon/components';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '@fontsource/jetbrains-mono/700.css';
import '@fontsource/ibm-plex-sans-arabic/400.css';
import '@fontsource/ibm-plex-sans-arabic/600.css';
import '@fontsource/ibm-plex-sans-arabic/700.css';
---

<!doctype html>
<html lang="en" dir="ltr" class="dark scroll-smooth bg-black text-white">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ERM / Metwally // Cyber-Neobrutalism Portfolio</title>
    <meta name="description" content="Personal cyber-neobrutalist portfolio & vault for ERM / Metwally - Digital forensics, Android modder, CTF player." />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" type="image/png" href="/avatar.png" />
    <link rel="preload" href="/avatar.png" as="image" />

    <style is:global>
      /* Zero rounded corners everywhere */
      *, *::before, *::after {
        border-radius: 0 !important;
      }

      /* Cyber scanline overlay */
      .scanlines {
        background: linear-gradient(
          to bottom,
          rgba(255,255,255,0),
          rgba(255,255,255,0) 50%,
          rgba(0, 0, 0, 0.35) 50%,
          rgba(0, 0, 0, 0.35)
        );
        background-size: 100% 4px;
      }

      /* Subtle Cyber Grid */
      .cyber-grid {
        background-image: 
          radial-gradient(rgba(37, 99, 235, 0.18) 1px, transparent 1px),
          radial-gradient(rgba(255, 255, 255, 0.05) 1px, transparent 1px);
        background-size: 28px 28px, 14px 14px;
        background-position: 0 0, 14px 14px;
      }

      /* Mechanical brutalist button press effect */
      .brutal-btn {
        transition: transform 0.08s cubic-bezier(0.2, 0, 0, 1), box-shadow 0.08s cubic-bezier(0.2, 0, 0, 1);
      }
      .brutal-btn:hover {
        transform: translate(-2px, -2px);
      }
      .brutal-btn:active {
        transform: translate(2px, 2px);
        box-shadow: 0px 0px 0px 0px #2563eb !important;
      }

      /* Dynamic font switching */
      html[dir="rtl"] body {
        font-family: 'IBM Plex Sans Arabic', system-ui, sans-serif;
      }
      html[dir="ltr"] body {
        font-family: 'JetBrains Mono', monospace;
      }

      /* Custom scrollbar */
      ::-webkit-scrollbar {
        width: 6px;
      }
      ::-webkit-scrollbar-track {
        background: #000000;
      }
      ::-webkit-scrollbar-thumb {
        background: #2563eb;
      }
      ::-webkit-scrollbar-thumb:hover {
        background: #3b82f6;
      }
    </style>
  </head>

  <body class="bg-black text-white min-h-screen selection:bg-blue-600 selection:text-white relative overflow-x-hidden">
    <!-- Background cyber grid & scanlines -->
    <div class="fixed inset-0 cyber-grid pointer-events-none z-0"></div>
    <div class="fixed inset-0 scanlines pointer-events-none z-10 opacity-60"></div>

    <!-- Toast Notification for clipboard & actions -->
    <div
      id="cyber-toast"
      class="fixed bottom-6 left-1/2 -translate-x-1/2 z-50 pointer-events-none opacity-0 translate-y-3 transition-all duration-200 border-2 border-white bg-blue-600 text-white font-mono text-xs sm:text-sm font-bold px-4 py-2 shadow-[4px_4px_0px_0px_#ffffff] flex items-center gap-2"
    >
      <Icon name="lucide:check" class="w-4 h-4 text-white" />
      <span id="toast-message">COPIED TO CLIPBOARD</span>
    </div>

    <!-- SHARP FLOATING TOP DOCK (Wider Layout: max-w-3xl) -->
    <header class="fixed top-3 sm:top-5 left-1/2 -translate-x-1/2 z-40 w-[94%] max-w-3xl">
      <nav
        class="bg-[#09090b]/95 backdrop-blur-md border-2 border-white sm:border-blue-600 shadow-[4px_4px_0px_0px_#2563eb] flex items-stretch justify-between p-1.5 select-none"
        aria-label="Main Navigation Dock"
      >
        <!-- 3 Tab Buttons -->
        <div class="flex items-stretch gap-1.5 sm:gap-2 flex-1">
          <button
            type="button"
            data-tab="id"
            class="tab-trigger brutal-btn flex-1 py-2 sm:py-2.5 px-3 text-center text-xs sm:text-sm font-bold border border-white/20 sm:border-blue-600/50 bg-blue-600 text-white shadow-[2px_2px_0px_0px_#ffffff] flex items-center justify-center gap-2"
            aria-selected="true"
          >
            <Icon name="lucide:terminal" class="w-4 h-4 shrink-0 hidden sm:inline-block" />
            <span data-i18n="dock.id">// 01.ID</span>
          </button>

          <button
            type="button"
            data-tab="vault"
            class="tab-trigger brutal-btn flex-1 py-2 sm:py-2.5 px-3 text-center text-xs sm:text-sm font-bold border border-white/10 bg-black text-zinc-400 hover:text-white hover:bg-[#12141a] flex items-center justify-center gap-2"
            aria-selected="false"
          >
            <Icon name="lucide:shield" class="w-4 h-4 shrink-0 hidden sm:inline-block text-blue-500" />
            <span data-i18n="dock.vault">// 02.VAULT</span>
          </button>

          <button
            type="button"
            data-tab="logs"
            class="tab-trigger brutal-btn flex-1 py-2 sm:py-2.5 px-3 text-center text-xs sm:text-sm font-bold border border-white/10 bg-black text-zinc-400 hover:text-white hover:bg-[#12141a] flex items-center justify-center gap-2"
            aria-selected="false"
          >
            <Icon name="lucide:file-text" class="w-4 h-4 shrink-0 hidden sm:inline-block text-blue-500" />
            <span data-i18n="dock.logs">// 03.LOGS</span>
          </button>
        </div>

        <!-- Language Switcher & SFX Audio Toggle -->
        <div class="flex items-stretch gap-1.5 pl-1.5 rtl:pr-1.5 rtl:pl-0 border-l rtl:border-r rtl:border-l-0 border-zinc-800 ml-1.5 rtl:mr-1.5 rtl:ml-0">
          <button
            id="lang-toggle"
            type="button"
            title="Toggle Language (EN / AR)"
            class="brutal-btn px-3 sm:px-4 py-2 sm:py-2.5 border border-white/30 bg-black text-white hover:bg-blue-600 hover:border-white text-xs sm:text-sm font-bold flex items-center gap-1.5 shadow-[2px_2px_0px_0px_#2563eb]"
          >
            <Icon name="lucide:globe" class="w-4 h-4 text-blue-400 shrink-0" />
            <span id="lang-label" class="tracking-wide">AR / عربي</span>
          </button>

          <button
            id="sfx-toggle"
            type="button"
            title="Toggle Mechanical Cyber Sound"
            class="brutal-btn px-2.5 py-2 border border-white/20 bg-black text-zinc-400 hover:text-white text-xs font-bold hidden sm:flex items-center justify-center"
          >
            <span id="sfx-icon">🔊</span>
          </button>
        </div>
      </nav>
    </header>

    <!-- MAIN SILHOUETTE CONTAINER (Wider Layout: max-w-3xl) -->
    <main class="relative z-20 max-w-3xl mx-auto pt-24 sm:pt-28 pb-16 px-4 sm:px-6">
      <!-- CENTERED SILHOUETTE CARD -->
      <section
        class="bg-[#09090b] border-2 border-white sm:border-blue-600 shadow-[6px_6px_0px_0px_#2563eb] sm:shadow-[8px_8px_0px_0px_#2563eb] overflow-hidden"
      >
        <!-- CARD TOP STATUS BAR (TTY / Cyber Bar) -->
        <div class="bg-black border-b-2 border-zinc-800 px-4 sm:px-6 py-2.5 flex items-center justify-between text-xs font-mono text-zinc-400 select-none">
          <div class="flex items-center gap-2.5">
            <span class="inline-block w-2.5 h-2.5 bg-blue-600 border border-white/40"></span>
            <span class="text-white font-bold tracking-wider">TTY1: erm@archbox</span>
          </div>
          <div class="flex items-center gap-3">
            <span class="flex items-center gap-1.5 text-zinc-300">
              <span class="relative flex h-2 w-2">
                <span class="animate-ping absolute inline-flex h-full w-full bg-emerald-400 opacity-75"></span>
                <span class="relative inline-flex h-2 w-2 bg-emerald-500"></span>
              </span>
              <span id="live-status-text" data-i18n="system.online">ONLINE</span>
            </span>
            <span class="text-zinc-600 hidden sm:inline">|</span>
            <span id="live-clock" class="text-blue-400 font-bold hidden sm:inline">00:00:00 UTC</span>
          </div>
        </div>

        <!-- PROFILE HERO HEADER (Generous spacing, less cramped) -->
        <div class="p-6 sm:p-8 border-b-2 border-zinc-800 bg-[#0d0f12]">
          <div class="flex flex-col sm:flex-row items-center sm:items-start gap-6 sm:gap-8 text-center sm:text-left rtl:sm:text-right">
            <!-- AVATAR BOX -->
            <div class="relative shrink-0">
              <div class="w-28 h-28 sm:w-32 sm:h-32 border-2 border-blue-600 bg-black shadow-[4px_4px_0px_0px_#ffffff] relative overflow-hidden group">
                <img
                  src="/avatar.png"
                  alt="ERM Avatar"
                  width="128"
                  height="128"
                  class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
                  loading="eager"
                />
                <div class="absolute inset-0 scanlines pointer-events-none opacity-40"></div>
              </div>
              <span
                class="absolute -bottom-1.5 -right-1.5 rtl:-right-auto rtl:-left-1.5 bg-emerald-500 text-black text-[9px] font-bold px-1.5 py-0.5 border border-black shadow-[2px_2px_0px_0px_#000000]"
                data-i18n="avatar.badge"
              >
                PROD
              </span>
            </div>

            <!-- IDENTITY INFO -->
            <div class="flex-1 min-w-0">
              <!-- Name & Nickname -->
              <div class="flex flex-wrap items-center justify-center sm:justify-start rtl:sm:justify-start gap-2.5 mb-2">
                <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-white font-mono uppercase">
                  <span data-i18n="profile.name">ERM / Metwally</span>
                  <span class="text-blue-500 ml-1.5 rtl:mr-1.5 text-xl sm:text-2xl font-normal" data-i18n="profile.arabicName">(متولي)</span>
                </h1>
                <span class="bg-blue-600 text-white text-[11px] font-bold px-2 py-0.5 border border-white tracking-widest uppercase">
                  ROOT
                </span>
              </div>

              <!-- Terminal Typewriter Subtitle -->
              <div class="bg-black border border-zinc-700 px-3.5 py-2 my-3 font-mono text-xs sm:text-sm text-left rtl:text-right shadow-[3px_3px_0px_0px_#2563eb] flex items-center gap-2 overflow-hidden">
                <span class="text-blue-400 font-bold shrink-0">root@box:~#</span>
                <span id="typewriter-text" class="text-zinc-200 font-semibold tracking-wide truncate">digital forensics</span>
                <span id="typewriter-cursor" class="text-blue-500 font-bold animate-pulse">_</span>
              </div>

              <!-- Short Bio -->
              <p
                id="profile-bio"
                class="text-sm sm:text-base text-zinc-300 leading-relaxed mt-2.5 font-normal"
                data-i18n="profile.bio"
              >
                a humble highschooler with interesting hobbies
              </p>

              <!-- Cyber Attributes Pills -->
              <div class="flex flex-wrap gap-2 mt-4 justify-center sm:justify-start rtl:sm:justify-start">
                <span class="bg-[#12141a] text-zinc-300 border border-zinc-700 text-xs font-bold px-2.5 py-1 font-mono">
                  [ OS: ARCH LINUX ]
                </span>
                <span class="bg-[#12141a] text-blue-400 border border-blue-900 text-xs font-bold px-2.5 py-1 font-mono">
                  [ CTF: PLAYER ]
                </span>
                <span class="bg-[#12141a] text-zinc-300 border border-zinc-700 text-xs font-bold px-2.5 py-1 font-mono" data-i18n="pills.foss">
                  [ FOSS ENTHUSIAST ]
                </span>
              </div>
            </div>
          </div>
        </div>

        <!-- ========================================== -->
        <!-- TAB PANELS SECTION                         -->
        <!-- ========================================== -->
        <div class="p-6 sm:p-8 bg-[#09090b]">

          <!-- ======================================== -->
          <!-- TAB 01: // 01.ID (Links & Identity)      -->
          <!-- ======================================== -->
          <div id="tab-id" class="tab-panel space-y-4">
            <!-- Tab Header Banner -->
            <div class="border border-zinc-800 bg-black/60 p-3 flex items-center justify-between text-xs sm:text-sm text-zinc-400 font-mono">
              <span class="text-blue-400 font-bold" data-i18n="tabId.title">// VERIFIED IDENTITIES & LINKS</span>
              <span class="text-xs border border-zinc-700 px-1.5 py-0.5">AUTH: OK</span>
            </div>

            <!-- LINK 1: GITHUB -->
            <a
              href="https://github.com/real-erm"
              target="_blank"
              rel="noopener noreferrer"
              class="brutal-btn block group border-2 border-white/80 hover:border-blue-600 bg-[#0d0f12] hover:bg-[#12141a] p-4 sm:p-5 shadow-[4px_4px_0px_0px_#2563eb] text-white"
            >
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-4">
                  <div class="w-11 h-11 border border-white/20 bg-black flex items-center justify-center shrink-0 group-hover:border-blue-500">
                    <Icon name="simple-icons:github" class="w-6 h-6 text-white group-hover:text-blue-400 transition-colors" />
                  </div>
                  <div>
                    <div class="flex items-center gap-2">
                      <span class="font-bold text-base sm:text-lg tracking-wide" data-i18n="links.github.title">GitHub</span>
                      <span class="text-[10px] bg-zinc-800 text-zinc-300 px-2 py-0.5 border border-zinc-600 font-mono">SOURCE</span>
                    </div>
                    <p class="text-xs sm:text-sm text-zinc-400 font-mono mt-1" data-i18n="links.github.subtitle">github.com/real-erm // Code, tools & repos</p>
                  </div>
                </div>
                <div class="text-zinc-500 group-hover:text-blue-400 transition-colors pl-2 rtl:pr-2 rtl:pl-0">
                  <Icon name="lucide:external-link" class="w-5 h-5" />
                </div>
              </div>
            </a>

            <!-- LINK 2: DISCORD -->
            <div class="border-2 border-white/80 hover:border-blue-600 bg-[#0d0f12] p-4 sm:p-5 shadow-[4px_4px_0px_0px_#2563eb] text-white">
              <div class="flex items-center justify-between flex-wrap gap-3">
                <a
                  href="https://discord.com/users/1261253325551304718"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center gap-4 group flex-1 min-w-[220px]"
                >
                  <div class="w-11 h-11 border border-white/20 bg-[#5865F2]/20 flex items-center justify-center shrink-0 group-hover:border-blue-500">
                    <Icon name="simple-icons:discord" class="w-6 h-6 text-[#5865F2]" />
                  </div>
                  <div>
                    <div class="flex items-center gap-2">
                      <span class="font-bold text-base sm:text-lg tracking-wide" data-i18n="links.discord.title">Discord Profile</span>
                      <span class="text-[10px] bg-emerald-950 text-emerald-400 px-2 py-0.5 border border-emerald-800 font-mono">ONLINE</span>
                    </div>
                    <p class="text-xs sm:text-sm text-zinc-400 font-mono mt-1">ID: 1261253325551304718</p>
                  </div>
                </a>

                <!-- Quick Action Buttons -->
                <div class="flex items-center gap-2">
                  <button
                    type="button"
                    class="copy-btn brutal-btn border border-white/40 bg-black hover:bg-blue-600 px-3 py-1.5 text-xs font-mono font-bold flex items-center gap-1.5 text-zinc-200 hover:text-white"
                    data-copy="1261253325551304718"
                    title="Copy Discord ID"
                  >
                    <Icon name="lucide:copy" class="w-4 h-4" />
                    <span data-i18n="links.discord.copy">COPY ID</span>
                  </button>
                  <a
                    href="https://discord.com/users/1261253325551304718"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="brutal-btn border border-blue-600 bg-blue-600 hover:bg-blue-700 px-3 py-1.5 text-xs font-mono font-bold text-white flex items-center gap-1.5"
                  >
                    <span data-i18n="links.discord.open">OPEN</span>
                    <Icon name="lucide:external-link" class="w-4 h-4" />
                  </a>
                </div>
              </div>
            </div>

            <!-- LINK 3: CTFTIME PROFILE -->
            <a
              href="https://ctftime.org/user/276029"
              target="_blank"
              rel="noopener noreferrer"
              class="brutal-btn block group border-2 border-white/80 hover:border-blue-600 bg-[#0d0f12] hover:bg-[#12141a] p-4 sm:p-5 shadow-[4px_4px_0px_0px_#ffffff] text-white"
            >
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-4">
                  <div class="w-11 h-11 border border-white/20 bg-black flex items-center justify-center shrink-0 group-hover:border-blue-500">
                    <Icon name="lucide:flag" class="w-6 h-6 text-amber-400" />
                  </div>
                  <div>
                    <div class="flex items-center gap-2">
                      <span class="font-bold text-base sm:text-lg tracking-wide" data-i18n="links.ctf.title">CTFtime Profile</span>
                      <span class="text-[10px] bg-amber-950 text-amber-300 px-2 py-0.5 border border-amber-800 font-mono">PLAYER</span>
                    </div>
                    <p class="text-xs sm:text-sm text-zinc-400 font-mono mt-1" data-i18n="links.ctf.subtitle">ctftime.org/user/276029 // Forensics, Reverse & Crypto</p>
                  </div>
                </div>
                <div class="text-zinc-500 group-hover:text-blue-400 transition-colors pl-2 rtl:pr-2 rtl:pl-0">
                  <Icon name="lucide:external-link" class="w-5 h-5" />
                </div>
              </div>
            </a>

            <!-- SYSTEM HARDWARE / RIG SPECS BOX (Minimal / Clean Flex) -->
            <div class="mt-5 border border-zinc-800 bg-black p-4 sm:p-5 font-mono text-xs sm:text-sm text-zinc-400">
              <div class="text-white font-bold mb-3 flex items-center gap-2">
                <Icon name="lucide:terminal" class="w-4 h-4 text-blue-400" />
                <span data-i18n="specs.title">SYS_CONFIG // WORKSTATION</span>
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs">
                <div><span class="text-blue-400 font-bold">&gt; OS:</span> Arch Linux (Zen Kernel)</div>
                <div><span class="text-blue-400 font-bold">&gt; SHELL:</span> Fish Shell</div>
                <div><span class="text-blue-400 font-bold">&gt; DESKTOP:</span> KDE Plasma (Wayland)</div>
                <div><span class="text-blue-400 font-bold">&gt; ARCH:</span> Haswell x86_64</div>
              </div>
            </div>
          </div>

          <!-- ======================================== -->
          <!-- TAB 02: // 02.VAULT (Clean Coming Soon)  -->
          <!-- ======================================== -->
          <div id="tab-vault" class="tab-panel hidden space-y-4">
            <!-- Vault Header Banner -->
            <div class="border border-zinc-800 bg-black/60 p-3 flex items-center justify-between text-xs sm:text-sm text-zinc-400 font-mono">
              <span class="text-blue-400 font-bold" data-i18n="vault.header">// PROJECTS & REPOSITORIES</span>
              <span class="text-xs bg-blue-950 text-blue-300 border border-blue-800 px-2 py-0.5">STATUS: 204</span>
            </div>

            <!-- Sleek Brutalist COMING SOON Card -->
            <div class="border-2 border-white/80 bg-[#0d0f12] p-8 sm:p-14 shadow-[4px_4px_0px_0px_#2563eb] text-center">
              <div class="inline-flex items-center justify-center w-14 h-14 border-2 border-blue-600 bg-black mb-4 shadow-[3px_3px_0px_0px_#ffffff]">
                <Icon name="lucide:shield" class="w-7 h-7 text-blue-400" />
              </div>
              <div>
                <span class="font-mono text-xs bg-amber-500 text-black border border-amber-300 px-3 py-1 font-extrabold tracking-widest inline-block animate-pulse">
                  [ COMING SOON ]
                </span>
              </div>
              <h2 class="text-lg sm:text-2xl font-bold text-white font-mono uppercase tracking-tight mt-4" data-i18n="vault.soonTitle">
                VAULT UNDER INITIALIZATION
              </h2>
              <p class="text-xs sm:text-sm text-zinc-400 font-mono max-w-md mx-auto mt-2 leading-relaxed" data-i18n="vault.soonDesc">
                Repositories, tools, and scripts are being curated. Check back soon.
              </p>
              <div class="mt-6 inline-block font-mono text-xs text-zinc-500 bg-black border border-zinc-800 px-4 py-2">
                root@box:~# ls -la /vault/ &gt; [STATUS: COMING SOON]
              </div>
            </div>
          </div>

          <!-- ======================================== -->
          <!-- TAB 03: // 03.LOGS (Clean Coming Soon)   -->
          <!-- ======================================== -->
          <div id="tab-logs" class="tab-panel hidden space-y-4">
            <!-- Logs Header Banner -->
            <div class="border border-zinc-800 bg-black/60 p-3 flex items-center justify-between text-xs sm:text-sm text-zinc-400 font-mono">
              <span class="text-blue-400 font-bold" data-i18n="logs.header">// WRITEUPS & LOGS</span>
              <span class="text-xs border border-zinc-700 px-2 py-0.5">0 ENTRIES</span>
            </div>

            <!-- Sleek Brutalist COMING SOON Card -->
            <div class="border-2 border-white/80 bg-[#0d0f12] p-8 sm:p-14 shadow-[4px_4px_0px_0px_#ffffff] text-center">
              <div class="inline-flex items-center justify-center w-14 h-14 border-2 border-blue-600 bg-black mb-4 shadow-[3px_3px_0px_0px_#2563eb]">
                <Icon name="lucide:file-text" class="w-7 h-7 text-blue-400" />
              </div>
              <div>
                <span class="font-mono text-xs bg-amber-500 text-black border border-amber-300 px-3 py-1 font-extrabold tracking-widest inline-block animate-pulse">
                  [ COMING SOON ]
                </span>
              </div>
              <h2 class="text-lg sm:text-2xl font-bold text-white font-mono uppercase tracking-tight mt-4" data-i18n="logs.soonTitle">
                LOGS & WRITEUPS
              </h2>
              <p class="text-xs sm:text-sm text-zinc-400 font-mono max-w-md mx-auto mt-2 leading-relaxed" data-i18n="logs.soonDesc">
                CTF writeups, forensic analysis notes, and articles will be published here.
              </p>
              <div class="mt-6 inline-block font-mono text-xs text-zinc-500 bg-black border border-zinc-800 px-4 py-2">
                root@box:~# cat /var/log/writeups &gt; [STATUS: COMING SOON]
              </div>
            </div>
          </div>

        </div>
      </section>
    </main>

    <!-- CLIENT-SIDE SCRIPT: TAB SWITCHER, TYPEWRITER, BILINGUAL ENGINE, SOUND EFFECTS -->
    <script is:inline>
      // ========================================================
      // 1. TRANSLATION DICTIONARY (EN & AR)
      // ========================================================
      const translations = {
        en: {
          dock: {
            id: "// 01.ID",
            vault: "// 02.VAULT",
            logs: "// 03.LOGS",
          },
          system: {
            online: "ONLINE",
            status: "TTY1: erm@archbox",
          },
          avatar: {
            badge: "PROD",
          },
          profile: {
            name: "ERM / Metwally",
            arabicName: "(متولي)",
